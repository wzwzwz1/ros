{
  "schema_version": "1.0",
  "profile": "mock",
  "paths": {
    "artifacts": "artifacts",
    "datasets": "datasets",
    "model_lock": "models.lock.json",
    "database": "artifacts/state/spatial.sqlite3"
  },
  "robot": {
    "robot_id": null,
    "ssh_host": "192.168.0.100",
    "ssh_user": "wheeltec",
    "gateway_url": "http://127.0.0.1:8765",
    "gateway_token_env": "ROBOT_GATEWAY_TOKEN",
    "expected_ros_distro": "humble"
  },
  "mac": {"listen_host": "127.0.0.1", "listen_port": 8080},
  "map": {"map_id": null, "manifest": null, "frame_id": "map"},
  "motion": {
    "enabled": false,
    "max_linear_speed_mps": 0.1,
    "allow_reverse": false,
    "allow_spin_recovery": false,
    "min_obstacle_clearance_m": 0.3,
    "footprint_m": null,
    "wheelbase_m": null,
    "min_turning_radius_m": null,
    "session_file": null,
    "lease_period_ms": 250,
    "lease_timeout_ms": 1000,
    "sensor_stale_ms": 500,
    "navigation_timeout_s": 180
  },
  "perception": {
    "enabled": false,
    "detector_model_id": "yolo11n",
    "runtime": "onnx",
    "calibration_id": null,
    "max_rgb_depth_skew_ms": 50,
    "stationary_capture_only": true,
    "max_concurrent_captures": 1,
    "capture_timeout_s": 5,
    "goal_validity_s": 5,
    "arrival_distance_from_object_boundary_m": [0.6, 1.0]
  },
  "memory": {
    "movable_object_reverify_after_s": 60,
    "require_map_id": true,
    "preserve_observations": true
  },
  "tasks": {
    "timeout_s": 300,
    "max_active_tasks": 1,
    "max_viewpoints": 3,
    "max_replans": 2,
    "max_stationary_verification_retries": 2,
    "resume_motion_after_restart": false
  },
  "planner": {
    "enabled": false,
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com",
    "model_id": null,
    "api_key_env": "DEEPSEEK_API_KEY",
    "image_input_enabled": false,
    "request_timeout_s": 30,
    "max_retries": 2,
    "max_model_requests_per_task": 8,
    "max_tool_calls_per_task": 20,
    "max_input_tokens_per_task": 40000,
    "max_output_tokens_per_task": 4000,
    "allow_silent_model_fallback": false
  },
  "voice": {
    "enabled": false,
    "sample_rate_hz": 16000,
    "channels": 1,
    "encoding": "s16le",
    "frame_ms": 20,
    "max_input_buffer_s": 2,
    "pre_roll_ms": 500,
    "wake_phrase": "你好小轮",
    "wake_phrase_is_provisional": true,
    "kws_model_id": "sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01",
    "kws_threshold": null,
    "stop_phrase": "停止",
    "stop_requires_wake": false,
    "vad_model_id": "silero-vad",
    "asr_model_id": "SenseVoiceSmall",
    "tts_model_id": "vits-melo-tts-zh_en",
    "max_utterance_s": 15,
    "end_silence_ms": 800,
    "no_speech_timeout_s": 5,
    "barge_in_enabled": false,
    "gate_input_during_playback": true
  }
}
